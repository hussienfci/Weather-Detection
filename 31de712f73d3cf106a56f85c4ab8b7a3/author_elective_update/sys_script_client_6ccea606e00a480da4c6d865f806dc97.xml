    <messages/>
    <name>Validate Weather Input</name>
    <script><![CDATA[function onSubmit() {
    var country = g_form.getValue('country');
    var city = g_form.getValue('city');
    var temperature = g_form.getValue('temperature');

    if (!country || country.trim().length < 2) {
        g_form.addErrorMessage('Country is required and must be at least 2 characters.');
        return false;
    }

    if (!city || city.trim().length < 2) {
        g_form.addErrorMessage('City is required and must be at least 2 characters.');
        return false;
    }

    if (temperature && isNaN(parseFloat(temperature))) {
        g_form.addErrorMessage('Temperature must be a valid number.');
        return false;
    }

    return true;
}
]]></script>
