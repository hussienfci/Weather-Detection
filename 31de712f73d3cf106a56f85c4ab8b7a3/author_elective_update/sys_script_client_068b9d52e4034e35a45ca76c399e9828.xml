    <messages/>
    <name>Unit Change Handler</name>
    <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) return;

    var unitLabels = {
        'C': 'Celsius',
        'F': 'Fahrenheit',
        'K': 'Kelvin'
    };

    var unitLabel = unitLabels[newValue] || newValue;
    g_form.addInfoMessage('Temperature unit changed to ' + unitLabel + '. Please ensure the temperature value matches the selected unit.');
}
]]></script>
